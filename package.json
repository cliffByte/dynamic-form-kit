{
  "name": "@dynamic-core/form-kit",
  "version": "0.1.1",
  "description": "Dynamic form builder, field renderers, and display components. Publish from this folder after bumping version (npm publish; scope access in publishConfig).",
  "license": "ISC",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "default": "./dist/styles.css"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build:css": "mkdir -p dist && tailwindcss -c tailwind.config.cjs -i ./src/styles/form-kit.css -o ./dist/styles.css --minify",
    "build": "npm run build:css && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "typecheck:linked": "node ../../frontend/scripts/link-form-kit-react.mjs && npm run typecheck"
  },
  "keywords": [
    "react",
    "dynamic-forms",
    "form-builder"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@etpl/nepali-datepicker": "^1.0.8",
