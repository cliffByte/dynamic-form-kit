{
  "name": "@dynamic-core/form-kit",
  "version": "2.15.0",
  "description": "Dynamic form builder, field renderers, and display components (Tailwind v4). Publish from this folder after bumping version (npm publish; scope access in publishConfig).",
  "license": "ISC",
  "author": {
    "name": "Dynamic Core",
    "email": "adhikarishishir50@gmail.com"
  },
  "sideEffects": [
    "**/*.css",
    "@zener/nepali-datepicker-react/index.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "default": "./dist/styles.css"
    },
    "./theme.css": {
      "default": "./dist/theme.css"
    },
    "./tailwind.css": {
      "default": "./src/styles/tailwind.css"
    },
    "./map.css": {
      "default": "./dist/styles/map.css"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build:css": "mkdir -p dist && mkdir -p dist/styles && npx @tailwindcss/cli -i ./src/styles/standalone.css -o ./dist/styles.css --minify && cp ./src/styles/theme.css ./dist/theme.css && cp ./src/styles/tailwind.css ./dist/tailwind.css && cp ./src/styles/map.css ./dist/styles/map.css",
    "build": "npm run build:css && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "typecheck:linked": "node ../../frontend/scripts/link-form-kit-react.mjs && npm run typecheck",
    "demo": "npm run build:css && npm --prefix demo run dev",
    "demo:build": "npm run build:css && npm --prefix demo run build",
    "demo:preview": "npm --prefix demo run preview"
  },
  "keywords": [
    "react",
    "dynamic-forms",
    "form-builder"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@lexical/code": "^0.39.0",
    "@lexical/file": "^0.39.0",
    "@lexical/hashtag": "^0.39.0",
    "@lexical/link": "^0.39.0",
    "@lexical/list": "^0.39.0",
    "@lexical/markdown": "^0.39.0",
    "@lexical/overflow": "^0.39.0",
    "@lexical/react": "^0.39.0",
    "@lexical/rich-text": "^0.39.0",
    "@lexical/selection": "^0.39.0",
    "@lexical/table": "^0.39.0",
    "@lexical/text": "^0.39.0",
    "@lexical/utils": "^0.39.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tiptap/extension-code-block-lowlight": "^3.15.3",
    "@tiptap/extension-color": "^3.15.3",
    "@tiptap/extension-horizontal-rule": "^3.15.3",
    "@tiptap/extension-image": "^3.15.3",
    "@tiptap/extension-link": "^3.15.3",
    "@tiptap/extension-text-align": "^3.15.3",
    "@tiptap/extension-text-style": "^3.15.3",
    "@tiptap/extension-typography": "^3.15.3",
    "@tiptap/extension-underline": "^3.15.3",
    "@tiptap/extensions": "^3.15.3",
    "@tiptap/pm": "^3.15.3",
    "@tiptap/react": "^3.15.3",
    "@tiptap/starter-kit": "^3.15.3",
    "@zener/nepali-date": "^1.1.5",
    "@zener/nepali-datepicker-react": "^1.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^10.18.0",
    "iso-639-1": "^3.1.5",
    "leaflet": "^1.9.4",
    "lexical": "^0.39.0",
    "lodash": "^4.17.23",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.292.0",
    "react-day-picker": "^9.13.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-error-boundary": "^6.1.0",
    "react-hook-form": "^7.71.1",
    "react-leaflet": "^4.2.1",
    "react-medium-image-zoom": "^5.4.0",
    "react-phone-number-input": "^3.4.14",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "uuid": "^9.0.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.21",
    "@types/lodash": "^4.17.23",
    "@types/node": "^20.8.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^9.0.6",
    "jsdom": "^29.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.2.2",
    "vitest": "^3.2.4"
  }
}
